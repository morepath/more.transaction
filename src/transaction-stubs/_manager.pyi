import threading
from collections.abc import Callable, Iterator
from types import TracebackType
from typing import ClassVar, TypeVar, overload

from transaction._transaction import Savepoint, Transaction
from transaction.interfaces import ISynchronizer

_T = TypeVar("_T")

class TransactionManager:
    explicit: bool
    run_no_func_types: ClassVar[tuple[type[int], type[None]]]
    def __init__(self, explicit: bool = False) -> None: ...
    def begin(self) -> Transaction: ...
    def __enter__(self) -> Transaction: ...
    def __exit__(
        self,
        t: type[BaseException] | None,
        v: BaseException | None,
        tb: TracebackType | None,
    ) -> None: ...
    def get(self) -> Transaction: ...
    def free(self, txn: Transaction) -> None: ...
    def registerSynch(self, synch: ISynchronizer) -> None: ...
    def unregisterSynch(self, synch: ISynchronizer) -> None: ...
    def clearSynchs(self) -> None: ...
    def registeredSynchs(self) -> bool: ...
    def isDoomed(self) -> bool: ...
    def doom(self) -> None: ...
    def commit(self) -> None: ...
    def abort(self) -> None: ...
    def savepoint(self, optimistic: bool = False) -> Savepoint: ...
    # The last item yielded is the manager itself, not an ``Attempt``.
    def attempts(self, number: int = 3) -> Iterator[Attempt | TransactionManager]: ...
    # ``run(func, tries)`` calls ``func`` and returns its result.  When ``func``
    # is omitted (or is an ``int``, which is then taken as ``tries``) a
    # decorator is returned that does the same.  Note that the decorator
    # returns the *result* of the call, not the decorated function.
    @overload
    def run(self, func: Callable[[], _T], tries: int = 3) -> _T: ...
    @overload
    def run(
        self, func: int | None = None, tries: int = 3
    ) -> Callable[[Callable[[], _T]], _T]: ...

class ThreadTransactionManager(threading.local):
    manager: TransactionManager
    explicit: bool
    def __init__(self) -> None: ...
    def begin(self) -> Transaction: ...
    def get(self) -> Transaction: ...
    def __enter__(self) -> Transaction: ...
    def commit(self) -> None: ...
    def abort(self) -> None: ...
    def __exit__(
        self,
        t: type[BaseException] | None,
        v: BaseException | None,
        tb: TracebackType | None,
    ) -> None: ...
    def doom(self) -> None: ...
    def isDoomed(self) -> bool: ...
    def savepoint(self, optimistic: bool = False) -> Savepoint: ...
    def registerSynch(self, synch: ISynchronizer) -> None: ...
    def unregisterSynch(self, synch: ISynchronizer) -> None: ...
    def clearSynchs(self) -> None: ...
    def registeredSynchs(self) -> bool: ...
    def attempts(self, number: int = 3) -> Iterator[Attempt | TransactionManager]: ...
    @overload
    def run(self, func: Callable[[], _T], tries: int = 3) -> _T: ...
    @overload
    def run(
        self, func: int | None = None, tries: int = 3
    ) -> Callable[[Callable[[], _T]], _T]: ...

class Attempt:
    success: bool
    manager: TransactionManager
    def __init__(self, manager: TransactionManager) -> None: ...
    def __enter__(self) -> Transaction: ...
    # Returns ``True`` (suppressing the exception) when the error is retryable,
    # so this is declared ``bool`` rather than ``None``: type checkers then
    # know the ``with`` body may be abandoned part-way.
    def __exit__(
        self,
        t: type[BaseException] | None,
        v: BaseException | None,
        tb: TracebackType | None,
    ) -> bool: ...
