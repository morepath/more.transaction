# The ``I*`` names are ``zope.interface.Interface`` instances at runtime, not
# classes.  ``zope.interface`` ships no type information, so they are modelled
# here as ``typing.Protocol`` classes instead.  That makes them usable for
# structural typing: a data manager or synchronizer declared with
# ``@implementer(IDataManager)`` (and no common base class) type-checks
# wherever an ``IDataManager`` is expected.
#
# Parameters that implementers supply (data managers, synchronizers) are
# positional-only so that implementations may name them freely.  They receive
# the concrete ``Transaction`` because that is the only implementation the
# ``transaction`` package ever passes; implementations may annotate the
# parameter as ``Transaction`` or as the wider ``ITransaction``.

from collections.abc import Callable, Iterable, Iterator, Mapping
from contextlib import AbstractContextManager
from typing import Any, Protocol, TypeAlias, TypeVar, overload

from transaction._transaction import Transaction

_T = TypeVar("_T")

# ``(hook, args, kws)`` as produced by the ``get*Hooks`` methods.
_HookEntry: TypeAlias = tuple[Callable[..., object], tuple[Any, ...], Mapping[str, Any]]

class ITransactionManager(Protocol):
    explicit: bool
    def begin(self) -> ITransaction: ...
    def get(self) -> ITransaction: ...
    def commit(self) -> None: ...
    def abort(self) -> None: ...
    def doom(self) -> None: ...
    def isDoomed(self) -> bool: ...
    def savepoint(self, optimistic: bool = False) -> ISavepoint: ...
    def registerSynch(self, synch: ISynchronizer) -> None: ...
    def unregisterSynch(self, synch: ISynchronizer) -> None: ...
    def clearSynchs(self) -> None: ...
    def registeredSynchs(self) -> bool: ...
    def attempts(
        self, number: int = 3
    ) -> Iterator[AbstractContextManager[ITransaction]]: ...
    @overload
    def run(self, func: Callable[[], _T], tries: int = 3) -> _T: ...
    @overload
    def run(
        self, func: int | None = None, tries: int = 3
    ) -> Callable[[Callable[[], _T]], _T]: ...

class ITransaction(Protocol):
    user: str
    description: str
    extension: dict[str, Any]
    def commit(self) -> None: ...
    def abort(self) -> None: ...
    def doom(self) -> None: ...
    def savepoint(self, optimistic: bool = False) -> ISavepoint: ...
    def join(self, datamanager: IDataManager, /) -> None: ...
    def note(self, text: str) -> None: ...
    def setExtendedInfo(self, name: str, value: Any) -> None: ...
    def addBeforeCommitHook(
        self,
        hook: Callable[..., object],
        args: Iterable[Any] = (),
        kws: Mapping[str, Any] | None = None,
    ) -> None: ...
    def getBeforeCommitHooks(self) -> Iterator[_HookEntry]: ...
    def addAfterCommitHook(
        self,
        hook: Callable[..., object],
        args: Iterable[Any] = (),
        kws: Mapping[str, Any] | None = None,
    ) -> None: ...
    def getAfterCommitHooks(self) -> Iterator[_HookEntry]: ...
    def addBeforeAbortHook(
        self,
        hook: Callable[..., object],
        args: Iterable[Any] = (),
        kws: Mapping[str, Any] | None = None,
    ) -> None: ...
    def getBeforeAbortHooks(self) -> Iterator[_HookEntry]: ...
    def addAfterAbortHook(
        self,
        hook: Callable[..., object],
        args: Iterable[Any] = (),
        kws: Mapping[str, Any] | None = None,
    ) -> None: ...
    def getAfterAbortHooks(self) -> Iterator[_HookEntry]: ...
    def set_data(self, ob: object, data: Any, /) -> None: ...
    def data(self, ob: object) -> Any: ...
    def isRetryableError(self, error: BaseException) -> bool: ...

class IDataManager(Protocol):
    # ``transaction_manager`` is part of the documented interface but is never
    # accessed by ``transaction``, so it is deliberately not required here.
    def abort(self, transaction: Transaction, /) -> None: ...
    def tpc_begin(self, transaction: Transaction, /) -> None: ...
    def commit(self, transaction: Transaction, /) -> None: ...
    def tpc_vote(self, transaction: Transaction, /) -> None: ...
    def tpc_finish(self, transaction: Transaction, /) -> None: ...
    def tpc_abort(self, transaction: Transaction, /) -> None: ...
    def sortKey(self) -> str: ...

class ISavepointDataManager(IDataManager, Protocol):
    def savepoint(self) -> IDataManagerSavepoint: ...

class IRetryDataManager(IDataManager, Protocol):
    def should_retry(self, exception: BaseException, /) -> bool: ...

class IDataManagerSavepoint(Protocol):
    def rollback(self) -> None: ...

class ISavepoint(Protocol):
    @property
    def valid(self) -> bool: ...
    def rollback(self) -> None: ...

class ISynchronizer(Protocol):
    def beforeCompletion(self, transaction: Transaction, /) -> None: ...
    def afterCompletion(self, transaction: Transaction, /) -> None: ...
    def newTransaction(self, transaction: Transaction, /) -> None: ...

class InvalidSavepointRollbackError(Exception): ...
class TransactionError(Exception): ...
class TransactionFailedError(TransactionError): ...
class DoomedTransaction(TransactionError): ...
class TransientError(TransactionError): ...
class NoTransaction(TransactionError): ...
class AlreadyInTransaction(TransactionError): ...
