from collections.abc import Iterator
from types import TracebackType

from transaction._manager import Attempt
from transaction._manager import ThreadTransactionManager as ThreadTransactionManager
from transaction._manager import TransactionManager as TransactionManager
from transaction._transaction import Savepoint as Savepoint
from transaction._transaction import Transaction as Transaction

manager: ThreadTransactionManager

# Module-level shortcuts that delegate to ``manager``.
def get() -> Transaction: ...
def begin() -> Transaction: ...
def commit() -> None: ...
def abort() -> None: ...
def doom() -> None: ...
def isDoomed() -> bool: ...
def savepoint(optimistic: bool = False) -> Savepoint: ...
def attempts(number: int = 3) -> Iterator[Attempt | TransactionManager]: ...

# These exist at runtime (``__enter__ = get``), but ``with transaction:`` does
# not work because Python looks special methods up on the type, not the module.
# Use ``with transaction.manager:`` instead.
def __enter__() -> Transaction: ...
def __exit__(
    t: type[BaseException] | None,
    v: BaseException | None,
    tb: TracebackType | None,
) -> None: ...
