import logging
from collections.abc import Callable, Iterable, Iterator, Mapping
from typing import Any, Final, TypeAlias

from transaction._manager import TransactionManager
from transaction.interfaces import IDataManager, ISynchronizer
from transaction.weakset import WeakSet

# ``(hook, args, kws)`` as produced by the ``get*Hooks`` methods.
_HookEntry: TypeAlias = tuple[Callable[..., object], tuple[Any, ...], Mapping[str, Any]]

class Status:
    ACTIVE: Final = "Active"
    COMMITTING: Final = "Committing"
    COMMITTED: Final = "Committed"
    DOOMED: Final = "Doomed"
    COMMITFAILED: Final = "Commit failed"

class Transaction:
    status: str
    log: logging.Logger
    extension: dict[str, Any]
    user: str
    description: str
    def __init__(
        self,
        synchronizers: WeakSet[ISynchronizer] | None = None,
        manager: TransactionManager | None = None,
    ) -> None: ...
    def isDoomed(self) -> bool: ...
    def doom(self) -> None: ...
    def join(self, resource: IDataManager) -> None: ...
    def savepoint(self, optimistic: bool = False) -> Savepoint: ...
    def commit(self) -> None: ...
    def abort(self) -> None: ...
    def getBeforeCommitHooks(self) -> Iterator[_HookEntry]: ...
    def addBeforeCommitHook(
        self,
        hook: Callable[..., object],
        args: Iterable[Any] = (),
        kws: Mapping[str, Any] | None = None,
    ) -> None: ...
    def getAfterCommitHooks(self) -> Iterator[_HookEntry]: ...
    def addAfterCommitHook(
        self,
        hook: Callable[..., object],
        args: Iterable[Any] = (),
        kws: Mapping[str, Any] | None = None,
    ) -> None: ...
    def getBeforeAbortHooks(self) -> Iterator[_HookEntry]: ...
    def addBeforeAbortHook(
        self,
        hook: Callable[..., object],
        args: Iterable[Any] = (),
        kws: Mapping[str, Any] | None = None,
    ) -> None: ...
    def getAfterAbortHooks(self) -> Iterator[_HookEntry]: ...
    def addAfterAbortHook(
        self,
        hook: Callable[..., object],
        args: Iterable[Any] = (),
        kws: Mapping[str, Any] | None = None,
    ) -> None: ...
    def data(self, ob: object) -> Any: ...
    def set_data(self, ob: object, ob_data: Any) -> None: ...
    def note(self, text: str | None) -> None: ...
    def setUser(self, user_name: str, path: str = "/") -> None: ...
    def setExtendedInfo(self, name: str, value: Any) -> None: ...
    def isRetryableError(self, error: BaseException) -> bool: ...

class Savepoint:
    transaction: Transaction | None
    def __init__(
        self, transaction: Transaction, optimistic: bool, *resources: IDataManager
    ) -> None: ...
    @property
    def valid(self) -> bool: ...
    def rollback(self) -> None: ...

class AbortSavepoint:
    datamanager: IDataManager
    transaction: Transaction
    def __init__(self, datamanager: IDataManager, transaction: Transaction) -> None: ...
    def rollback(self) -> None: ...

class NoRollbackSavepoint:
    datamanager: IDataManager
    def __init__(self, datamanager: IDataManager) -> None: ...
    def rollback(self) -> None: ...

def rm_key(rm: IDataManager) -> str | None: ...
def text_or_warn(s: object) -> str: ...
